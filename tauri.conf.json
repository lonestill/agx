{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agx",
  "version": "1.3.6",
  "identifier": "com.lonestill.agx",
  "build": {
    "frontendDist": "./ui"
  },
  "bundle": {
    "icon": [
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "agx — Antigravity Multi-Tool",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
